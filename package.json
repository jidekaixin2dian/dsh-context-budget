{
  "name": "@jidekaixin2dian/dsh-toolgate",
  "version": "0.1.1",
  "description": "Manage MCP servers and skills in DeepSeek Harness, and control which tools enter the next prompt. Budget changes need no config edit or restart.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "assets",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "setup:host": "node scripts/setup-host.mjs",
    "test:host": "node scripts/test-host.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidekaixin2dian/dsh-toolgate.git"
  },
  "homepage": "https://github.com/jidekaixin2dian/dsh-toolgate#readme",
  "bugs": {
    "url": "https://github.com/jidekaixin2dian/dsh-toolgate/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skills",
    "context",
    "tokens"
  ],
  "author": "jidekaixin2dian",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/dsh-app-boot": "*",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-include": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
